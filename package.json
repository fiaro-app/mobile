{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "App móvil de Fiaro para Collectors — registro de visitas de cobro en campo.",
  "author": "Alejo Zuleta <valenciazuletaj@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/fiaro-app/mobile#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiaro-app/mobile.git"
  },
  "bugs": {
    "url": "https://github.com/fiaro-app/mobile/issues"
  },
  "keywords": [
    "fiaro",
    "expo",
    "react-native",
    "cobranza",
    "fintech"
  ],
  "dependencies": {
    "@better-auth/expo": "~1.7.7",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "better-auth": "~1.7.7",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-environment-node": "^30.5.2",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.3.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "docs": "typedoc",
    "test:cov": "jest --coverage",
    "build": "expo export --platform android --output-dir dist"
  },
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/lib/**/*.ts",
      "src/features/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/*.d.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "lcovonly"
    ]
  }
}
